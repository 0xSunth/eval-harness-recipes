            "datePublished": "2020-06-04T18:03:19+02:00",
            "dateModified": "2026-08-24T05:02:09+02:00",
            "prepTime": "PT10M",
            "cookTime": "PT1H",
            "totalTime": "PT1H10M",
            "recipeYield": "4 personnes",
            "recipeIngredient": [
                "4 cuisses de poulet",
                "400 g de riz parfum\u00e9",
                "1 cuill\u00e8re \u00e0 caf\u00e9 de poivre",
                "1 cuill\u00e8re \u00e0 caf\u00e9 de sel",
                "2 feuilles de laurier",
                "8 oignons",
                "3 \u00e9chalotes",
                "4 gousses d'ail",
                "1 cuill\u00e8re \u00e0 caf\u00e9 rase de gingembre",
                "1 cuill\u00e8re \u00e0 soupe de vinaigre d'alcool color\u00e9",
                "1 cube de bouillon de volaille",
                "8 cuill\u00e8res \u00e0 soupe d'huile de tournesol",
                "130 g d'olives",
                "1 citron vert",
                "2 cuill\u00e8res \u00e0 soupe de moutarde (facultatif)",
                "1 piment (facultatif)",
                "350 ml d'eau"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "Dans une cocotte mettre l'huile \u00e0 chauffer puis saisir les cuisses de poulet, saler et poivrer."
                },
                {
                    "@type": "HowToStep",
                    "text": "Couper en lamelles fine les oignons et \u00e9chalotes, les ajouter dans la cocotte."
                },
                {
                    "@type": "HowToStep",
                    "text": "Remuez de temps en temps, cuire 5mn \u00e0 feu doux/moyen."
                },
                {
                    "@type": "HowToStep",
                    "text": "Pendant ce temps, cuire votre riz selon votre mode de cuisson habituel."
                },
                {
                    "@type": "HowToStep",
                    "text": "Ajoutez progressivement dans la cocotte, le vinaigre, les feuilles de laurier, les gousses d'ail, le cube."
                },
                {
                    "@type": "HowToStep",
                    "text": "Baissez le feu et cuire encore 5mn tout en remuant. Les oignons commencent \u00e0 r\u00e9duire et dorer."
                },
                {
                    "@type": "HowToStep",
                    "text": "Sortez les cuisses de poulet, les mettre sur une plaque au four avec un peu d'eau et les faire dorer de chaque cot\u00e9 pendant 20mn."
                },
                {
                    "@type": "HowToStep",
                    "text": "Ajouter l'eau, les olives, le piment et laisser mijoter pendant 20mn \u00e0 petit feu avec le couvercle."
                },
                {
                    "@type": "HowToStep",
                    "text": "\u00c9teindre le feu puis mettre le jus de citron vert. Servez avec le riz."
                }
            ],
