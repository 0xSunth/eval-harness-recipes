            "datePublished": "2006-10-23T11:43:00+02:00",
            "dateModified": "2026-07-27T05:01:59+02:00",
            "prepTime": "PT20M",
            "cookTime": "PT20M",
            "totalTime": "PT40M",
            "recipeYield": "4 personnes",
            "recipeIngredient": [
                "6 saucisses fum\u00e9es (genre diots de Savoie) ou 4 grosses saucisses fum\u00e9es type Montb\u00e9liard",
                "4 tomates (en conserve hors saison)",
                "4 oignons",
                "6 gousses d'ail",
                "thym",
                "laurier",
                "poivre",
                "sel",
                "1 cuill\u00e8re \u00e0 caf\u00e9 de curcuma (safran)",
                "1 piment oiseau (facultatif)",
                "huile d'olive"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "Piquez les saucisses et mettez les dans l'eau bouillante pendant 10 mn, dans la m\u00eame marmite qui vous servira \u00e0 la pr\u00e9paration du plat afin de garder les saveurs. "
                },
                {
                    "@type": "HowToStep",
                    "text": "Videz la marmite. R\u00e9servez les saucisses. Faites-y chauffer de l'huile d'olive. "
                },
                {
                    "@type": "HowToStep",
                    "text": "Faites revenir les oignons \u00e9minc\u00e9s et l'ail \u00e9cras\u00e9 sans qu'ils soient trop color\u00e9s. "
                },
                {
                    "@type": "HowToStep",
                    "text": "Coupez les saucisses en troncons de 1,5 cm puis faites les revenir avec les oignons. Au bout de 5 mn, ajoutez les tomates coup\u00e9es en petits morceaux et les aromates (le piment en morceaux). "
                },
                {
                    "@type": "HowToStep",
                    "text": "M\u00e9langez le tout puis laisser mijoter sur feu doux en \u00f4tant le couvercle de temps \u00e0 autre pour \u00e9liminer l'exc\u00e8s d'eau. "
                },
                {
                    "@type": "HowToStep",
                    "text": "Servez avec du riz thai"
                }
            ],
