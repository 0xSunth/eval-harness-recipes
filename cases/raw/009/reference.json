            "recipeIngredient": [
                "2 betteraves",
                "1 gousse d'ail",
                "1 cuill\u00e8re \u00e0 caf\u00e9 d'huile d'olive",
                "2 yaourts bulgare (ou Fjord)",
                "1 concombre",
                "poivre",
                "sel",
                "concombre (un peu, pour d\u00e9corer)",
                "persil plat (pour d\u00e9corer)"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "Faire cuire les betteraves (\u00e0 la cocotte minute,c'est plus rapide)."
                },
                {
                    "@type": "HowToStep",
                    "text": "Quand elles sont froides, les mixer avec les yaourts, huile d'olive, concombre, ail, sel, poivre."
                },
                {
                    "@type": "HowToStep",
                    "text": "R\u00e9partir sur les assiettes. D\u00e9corer de fins b\u00e2tonnets de concombres et de persil plat."
                },
                {
                    "@type": "HowToStep",
                    "text": "Attention aux yeux... La couleur surprend, mais le go\u00fbt est exquis!"
                }
            ],
