                "https://assets.afcdn.com/recipe/20171012/73069_w1024h576c1cx1944cy1292cxt0cyt0cxb3888cyb2585.webp"
            ],
            "datePublished": "2007-11-21T10:13:00+01:00",
            "dateModified": "2026-07-27T05:01:59+02:00",
            "prepTime": "PT20M",
            "cookTime": "PT1H",
            "totalTime": "PT1H20M",
            "recipeYield": "4 personnes",
            "recipeIngredient": [
                "500 g de chair \u00e0 saucisse",
                "4 tomates (ou 8 petites)",
                "3 oignons",
                "2 gousses d'ail",
                "thym",
                "persil",
                "beurre",
                "poivre",
                "sel"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "Eplucher et hacher les oignons. Eplucher et hacher les gousses d'ail."
                },
                {
                    "@type": "HowToStep",
                    "text": "Mettre la moiti\u00e9 des oignons dans la chair \u00e0 saucisse. Ajouter l'ail, le sel, le poivre et un peu de persil."
                },
                {
                    "@type": "HowToStep",
                    "text": "Couper le haut des tomates et les \u00e9vider. Poivrer et saler l'int\u00e9rieur. Mettre la farce \u00e0 l'int\u00e9rieur et remettre les chapeaux."
                },
                {
                    "@type": "HowToStep",
                    "text": "Mettre le reste des oignons dans un plat avec la chair des tomates."
                },
                {
                    "@type": "HowToStep",
                    "text": "Mettre les tomates farcies dans le plat. Parsemez d'un peu de thym et mette une noisette de beurre sur chaque tomates. Faire cuire au four chaud \u00e0 180\u00b0C (thermostat 6) pendant 1 heure environ."
                },
                {
                    "@type": "HowToStep",
                    "text": "Servir avec du riz."
                }
            ],
