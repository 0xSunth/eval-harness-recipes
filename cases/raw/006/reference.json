            "prepTime": "PT20M",
            "cookTime": "PT0S",
            "totalTime": "PT20M",
            "recipeYield": "6 personnes",
            "recipeIngredient": [
                "5 tomates moyennes",
                "1 concombre",
                "1 oignon blanc \u00e9pluch\u00e9",
                "6 branches de menthe",
                "200 ml de jus de citron",
                "4 cuill\u00e8res \u00e0 soupe de persil hach\u00e9 surgel\u00e9",
                "1 cuill\u00e8re de sel",
                "1 pinc\u00e9e de poivre",
                "400 g de semoule moyenne"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "Laver, \u00f4tez le p\u00e9doncule des tomates et coupez-les en 4. Mixez-les dans un robot. Disposez-les dans un saladier."
                },
                {
                    "@type": "HowToStep",
                    "text": "\u00c9pluchez le concombre, coupez-le en gros cubes et mixez-le dans le robot. Disposez-les avec les tomates."
                },
                {
                    "@type": "HowToStep",
                    "text": "\u00c9pluchez l'oignon blanc, coupez-le en 4 et disposez-le dans le robot, ajoutez les feuilles de menthe et le jus de citron. Mixez et versez le m\u00e9lange avec les tomates et le concombre."
                },
                {
                    "@type": "HowToStep",
                    "text": "Ajoutez le persil, le sel, le poivre et la semoule, Remuez bien, poser un couvercle dessus et laissez reposer 35 minutes au frigo pour permettre \u00e0 la semoule de gonfler."
                },
                {
                    "@type": "HowToStep",
                    "text": "Servir tr\u00e8s frais."
                }
            ],
