                "https://assets.afcdn.com/recipe/20211215/125913_w1024h576c1cx996cy800cxt0cyt0cxb2121cyb1414.jpg",
                "https://assets.afcdn.com/recipe/20211215/125913_w1024h576c1cx996cy800cxt0cyt0cxb2121cyb1414.webp"
            ],
            "datePublished": "2015-03-06T01:42:00+01:00",
            "dateModified": "2026-03-23T05:01:28+01:00",
            "prepTime": "PT45M",
            "cookTime": "PT1H30M",
            "totalTime": "PT2H15M",
            "recipeYield": "8 Personnes",
            "recipeIngredient": [
                "500 g de farine",
                "250 g de beurre",
                "1 cuill\u00e8re \u00e0 caf\u00e9 de sel",
                "500 g de veau (ou de poulet ou de canard )",
                "300 g de porc",
                "250 g de chair \u00e0 saucisse",
                "1 oeuf",
                "3 cuill\u00e8res \u00e0 soupe de sel fin",
                "1 pinc\u00e9e de poivre",
                "1 pinc\u00e9e de muscade",
                "2 cuill\u00e8res \u00e0 soupe d'armagnac",
                "1 sachet de gel\u00e9e",
                "1 jaune d'oeuf pour dorer"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "A pr\u00e9parer la veille !"
                },
                {
                    "@type": "HowToStep",
                    "text": "Faire la p\u00e2te : mettre farine et beurre en morceaux dans un saladier, sabler. Ajouter une pinc\u00e9e de sel, l'eau pour obtenir une boule de p\u00e2te, \u00e0 laisser reposer une demi-heure"
                },
                {
                    "@type": "HowToStep",
                    "text": "Pr\u00e9chauffer le four \u00e0 240\u00b0C."
                },
                {
                    "@type": "HowToStep",
                    "text": "Pendant ce temps, pr\u00e9parer la farce : hacher les viandes, les m\u00e9langer \u00e0 la chair \u00e0 saucisse. Ajouter l'oeuf, l'armagnac, la muscade, le sel et le poivre."
                },
                {
                    "@type": "HowToStep",
                    "text": "Bien m\u00e9langer."
                },
                {
                    "@type": "HowToStep",
                    "text": "Etaler la p\u00e2te sur un papier sulfuris\u00e9 en lui donnant une forme ovale. D\u00e9poser la farce sur une moiti\u00e9 dans la longueur. Replier la p\u00e2te pour former un chausson."
                },
                {
                    "@type": "HowToStep",
                    "text": "Bien souder les bords en les humidifiant."
                },
                {
                    "@type": "HowToStep",
                    "text": "Faire un petit trou sur le dessus et y glisser une petite chemin\u00e9e faite en papier d'alu. "
                },
                {
                    "@type": "HowToStep",
                    "text": "Dorer \u00e0 l'oeuf"
                },
                {
                    "@type": "HowToStep",
                    "text": "Glisser le p\u00e2t\u00e9 avec le papier sulfuris\u00e9 sur une plaque du four"
                },
                {
                    "@type": "HowToStep",
                    "text": "Faire cuire 45 min \u00e0 240\u00b0C  puis 45 min \u00e0 220\u00b0C."
                },
                {
                    "@type": "HowToStep",
                    "text": "Laisser refroidir compl\u00e8tement"
                },
                {
                    "@type": "HowToStep",
                    "text": "Pr\u00e9parer la gel\u00e9e selon les indications du paquet et une fois froide, la verser par le trou de la chemin\u00e9e."
                },
                {
                    "@type": "HowToStep",
                    "text": "A laisser au r\u00e9frig\u00e9rateur une nuit."
                },
                {
                    "@type": "HowToStep",
                    "text": "Bonne d\u00e9gustation !"
                }
            ],
