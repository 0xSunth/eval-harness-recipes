                "https://assets.afcdn.com/recipe/20230620/143594_w1024h768c1cx960cy540cxt0cyt0cxb1920cyb1080.webp",
                "https://assets.afcdn.com/recipe/20230620/143594_w1024h576c1cx960cy540cxt0cyt0cxb1920cyb1080.jpg",
                "https://assets.afcdn.com/recipe/20230620/143594_w1024h576c1cx960cy540cxt0cyt0cxb1920cyb1080.webp"
            ],
            "datePublished": "2006-10-23T11:43:00+02:00",
            "dateModified": "2026-07-13T05:02:10+02:00",
            "prepTime": "PT45M",
            "cookTime": "PT30M",
            "totalTime": "PT1H15M",
            "recipeYield": "8 personnes",
            "recipeIngredient": [
                "4 oeufs",
                "180 g de sucre",
                "120 g de farine",
                "1 sachet de levure",
                "160 g de beurre fondu",
                "100 g de chocolat",
                "100 g de copeaux de chocolat",
                "40 cl de cr\u00e8me fra\u00eeche enti\u00e8re",
                "cerises confites maisons ou cerises \u00e0 l\u2019eau de vie"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "M\u00e9langer oeufs, sucre au fouet sur un bain-marie (pas trop chaud)."
                },
                {
                    "@type": "HowToStep",
                    "text": "Ajouter farine tamis\u00e9e, levure et le beurre"
                },
                {
                    "@type": "HowToStep",
                    "text": "Ajouter le chocolat fondu (sur un bain-marie \u00e0 30, 35\u00b0C)."
                },
                {
                    "@type": "HowToStep",
                    "text": "Faire cuire dans deux moules (diam\u00e8tre 20 ou 24) \u00e0 175\u00b0C pendant 30 minutes (chaleur conventionnelle)."
                },
                {
                    "@type": "HowToStep",
                    "text": "Les copeaux sont r\u00e9alis\u00e9s par \u00e9talement en fine couche du chocolat fondu sur une plaque de marbre. Choisir le moment, ni trop froid, ni trop chaud pour les former."
                },
                {
                    "@type": "HowToStep",
                    "text": "Les g\u00e2teaux refroidis, les couper en deux, les imbiber du jus de cerise additionn\u00e9 de kirsch "
                },
                {
                    "@type": "HowToStep",
                    "text": "Monter la cr\u00e8me en chantilly avec 100g de sucre glace."
                },
                {
                    "@type": "HowToStep",
                    "text": "Former le g\u00e2teau premi\u00e8re couche chantilly avec des morceaux de cerises deuxi\u00e8me couche une r\u00e9duction du jus de cerise avec un apport de sucre pour faire un caramel pas trop dur et derni\u00e8re couche de chantilly avec des morceaux de cerises."
                },
                {
                    "@type": "HowToStep",
                    "text": "Enduire le g\u00e2teau de chantilly et disposer les copeaux de chocolat."
                },
                {
                    "@type": "HowToStep",
                    "text": "Pour un g\u00e2teau de 28 cm de diam\u00e8tre multiplier les proportions par 1,5."
                }
            ],
