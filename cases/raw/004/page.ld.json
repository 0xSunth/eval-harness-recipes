            "totalTime": "PT15M",
            "recipeYield": "8 personnes",
            "recipeIngredient": [
                "400 ml de lait de coco",
                "800 ml de lait concentr\u00e9 sucr\u00e9",
                "9 feuilles de G\u00e9latine",
                "1 pinc\u00e9e de vanille en poudre sucr\u00e9e"
            ],
            "recipeInstructions": [
                {
                    "@type": "HowToStep",
                    "text": "Faire tremper les feuilles de g\u00e9latine dans de l'eau froide 5mn, puis les plonger dans une casserole avec 40 cl d'eau bouillante. M\u00e9langer jusqu'\u00e0 ce que la g\u00e9latine ait enti\u00e8rement fondu."
                },
                {
                    "@type": "HowToStep",
                    "text": "Dans un mixer, m\u00e9langer le lait concentr\u00e9, le lait de coco, la g\u00e9latine fondue et 40 cl d'eau froide."
                },
                {
                    "@type": "HowToStep",
                    "text": "Verser dans des ramequins et saupoudrer un peu de vanille dans chaque."
                },
                {
                    "@type": "HowToStep",
                    "text": "Placer au r\u00e9frig\u00e9rateur 24h minimum."
                }
            ],
